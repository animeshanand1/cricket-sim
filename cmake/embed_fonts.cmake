# Turns third_party/fonts/*.ttf into one C++ file with byte arrays and an embeddedFont() lookup,
# so the game exe carries its fonts. Usage: t20_embed_fonts(<out.cpp> <font files...>)
function(t20_embed_fonts out)
  set(body "// Generated by cmake/embed_fonts.cmake from third_party/fonts. Do not edit.\n#include \"ui/fonts_embedded.hpp\"\n\nnamespace t20::ui {\nnamespace {\n")
  set(lookup "")
  foreach(f IN LISTS ARGN)
    get_filename_component(face "${f}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${face}" ident)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "const unsigned char k_${ident}[${size}] = {\n${bytes}\n};\n")
    string(APPEND lookup "  if (face == \"${face}\") return {k_${ident}, sizeof k_${ident}};\n")
  endforeach()
  string(APPEND body "}  // namespace\n\nEmbeddedFont embeddedFont(std::string_view face) {\n${lookup}  return {};\n}\n\n}  // namespace t20::ui\n")
  file(WRITE "${out}.tmp" "${body}")
  file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
  file(REMOVE "${out}.tmp")
endfunction()
